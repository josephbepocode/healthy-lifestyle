{"note":"Keyed by food id. Quantities are for 1 serving; scale by servings. Ingredient amounts are approximate. No swallows, tuna or fresh fish.","recipes":{"egg":{"totalMinutes":8,"servings":1,"ingredients":[{"item":"Eggs","amount":"1 large"},{"item":"Oil or butter","amount":"1 tsp"},{"item":"Salt, pepper","amount":"pinch"}],"steps":[{"text":"Heat oil in a pan on medium."},{"text":"Crack in the egg; cook until set to your liking.","timerSeconds":180},{"text":"Season and serve."}]},"jollof":{"totalMinutes":55,"servings":1,"ingredients":[{"item":"Long-grain parboiled rice","amount":"1 cup dry (makes ~3 cups)"},{"item":"Tomatoes","amount":"3 medium"},{"item":"Red bell pepper","amount":"1"},{"item":"Scotch bonnet","amount":"1/2 (to taste)"},{"item":"Onion","amount":"1 large, half blended, half sliced"},{"item":"Tomato paste","amount":"2 tbsp"},{"item":"Vegetable oil","amount":"3 tbsp"},{"item":"Curry, thyme, bouillon cube","amount":"1 tsp each / 1 cube"},{"item":"Chicken or veg stock","amount":"1.5 cups"}],"steps":[{"text":"Blend tomatoes, pepper, scotch bonnet and half the onion; simmer until thick.","timerSeconds":900},{"text":"Fry sliced onion in oil, add tomato paste for 3 min, then pour in the blended sauce and fry until oil floats.","timerSeconds":600},{"text":"Add spices, bouillon and stock; bring to a boil."},{"text":"Add washed rice, stir once, cover tightly with foil under the lid, and cook on low.","timerSeconds":1500},{"text":"Rest 5 min, fluff, and serve.","timerSeconds":300}]},"fried-chicken-thigh":{"totalMinutes":40,"servings":1,"ingredients":[{"item":"Chicken thighs","amount":"2 (bone-in)"},{"item":"Garlic, ginger","amount":"1 tsp each"},{"item":"Curry, paprika, bouillon","amount":"1 tsp each / 1 cube"},{"item":"Oil for frying","amount":"1/2 cup"}],"steps":[{"text":"Season chicken with garlic, ginger, spices and bouillon; rest 15 min if you can.","timerSeconds":900},{"text":"Steam or boil 10 min with a splash of water so it cooks through.","timerSeconds":600},{"text":"Fry in hot oil, turning, until golden and crisp.","timerSeconds":600},{"text":"Drain on paper and serve."}]},"fried-plantain":{"totalMinutes":15,"servings":1,"ingredients":[{"item":"Ripe plantain","amount":"1 large"},{"item":"Oil","amount":"1/3 cup"},{"item":"Salt","amount":"pinch"}],"steps":[{"text":"Peel and slice plantain on a diagonal."},{"text":"Heat oil on medium; sprinkle slices with salt."},{"text":"Fry 2 min per side until deep golden.","timerSeconds":240},{"text":"Drain on paper towel."}]},"moi-moi":{"totalMinutes":75,"servings":1,"ingredients":[{"item":"Peeled black-eyed beans (or canned, drained)","amount":"1.5 cups"},{"item":"Red bell pepper","amount":"1"},{"item":"Onion","amount":"1/2"},{"item":"Scotch bonnet","amount":"1/2"},{"item":"Oil","amount":"3 tbsp"},{"item":"Eggs","amount":"2, boiled and sliced"},{"item":"Bouillon, salt","amount":"1 cube / pinch"},{"item":"Warm water","amount":"1 cup"}],"steps":[{"text":"Blend beans with pepper, onion and scotch bonnet using warm water into a smooth batter."},{"text":"Stir in oil, bouillon and salt."},{"text":"Pour into oven-safe cups or foil and add a slice of egg to each."},{"text":"Steam in a pot with a little water (or bake in a water bath) until firm.","timerSeconds":2700},{"text":"Cool 5 min before unwrapping.","timerSeconds":300}]},"ewa":{"totalMinutes":70,"servings":1,"ingredients":[{"item":"Brown or black-eyed beans","amount":"1 cup dry (or 2 cans)"},{"item":"Palm or veg oil","amount":"3 tbsp"},{"item":"Onion","amount":"1 large"},{"item":"Blended tomato-pepper mix","amount":"1/2 cup"},{"item":"Crayfish (optional), bouillon","amount":"1 tbsp / 1 cube"}],"steps":[{"text":"Boil dry beans until very soft (skip if canned).","timerSeconds":2700},{"text":"Fry onion in oil, add blended pepper mix and cook until thick.","timerSeconds":600},{"text":"Add beans with a little of their water, crayfish and bouillon."},{"text":"Simmer and mash a few beans to thicken.","timerSeconds":600}]},"efo-riro":